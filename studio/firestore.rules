rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: read role from /users/{uid}
    function getUserRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Admins are identified by the role on their user document OR by one of the
    // hard-coded owner addresses — the app grants admin by email, so a rule that
    // only trusted the stored role locked real admins out of admin-only data.
    function isSuperAdminEmail() {
      return request.auth != null && request.auth.token.email in [
        'fedizayen12@gmail.com',
        'khaled05062006@gmail.com',
        'khaled050620062@gmail.com'
      ];
    }

    function isAdmin() {
      return request.auth != null &&
        (getUserRole(request.auth.uid) == 'admin' || isSuperAdminEmail());
    }

    // Declared after isAdmin so the owner-by-email path applies here too:
    // an owner with no user document has no stored role to match on.
    /**
     * Coaching material an athlete or another coach is allowed to read.
     *
     * Programmes, resources and reports were readable by every signed-in user,
     * which made the team centre one shared pile across every coach and every
     * sport. Ownership plus an explicit audience replaces that. Documents
     * written before these fields existed have no ownerId, and are left
     * readable so nothing already in the app disappears.
     */
    function canReadShared() {
      return request.auth != null && (
        isAdmin()
        || !('ownerId' in resource.data)
        || resource.data.ownerId == request.auth.uid
        || resource.data.visibility == 'public'
        || (resource.data.visibility == 'audience'
            && request.auth.uid in resource.data.audience)
      );
    }

    function isAdminOrCoach() {
      return isAdmin() || (request.auth != null && getUserRole(request.auth.uid) == 'coach');
    }

    // USERS
    match /users/{userId} {
      // Any signed-in user can read profiles (needed for messaging/team directory)
      allow read: if request.auth != null;

      // Create own. The signup form builds this document on the client, so the
      // role it carries is attacker-controlled: without the second clause any
      // new account could simply declare itself an admin. Only the hard-coded
      // owner addresses may create a document that already claims 'admin'.
      allow create: if isOwner(userId) && (
        request.resource.data.get('role', 'player') != 'admin' || isSuperAdminEmail()
      );

      // Update: user can update own EXCEPT role/plan. Admin can update anything.
      // Exception: the two protected super-admin accounts can never have their
      // role changed away from 'admin', no matter who performs the update.
      //
      // This must use isAdmin(), not getUserRole() alone: an owner identified
      // only by email has no stored role to read (and may have no user document
      // at all), so the role-only check denied them every write — which is what
      // silently blocked the admin streak editor on every athlete.
      //
      // The owner clause tests which keys the write *changes*, not which keys
      // the resulting document *has*. On an update `request.resource.data` is
      // the document as it will be after the write, so `'role' in ...` is true
      // for any profile that already stores a role — which is every profile
      // created at signup. That form would lock athletes out of editing their
      // own settings, photo or streak, while still being no stricter about
      // privilege escalation. Negating hasAny() says what was meant — the rules
      // language has hasAll/hasAny/hasOnly and no hasNone.
      allow update: if request.auth != null && (
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan'])) ||
        isAdmin() ||
        // Coach/admin can update a player's status (available/injured/suspended)
        // without touching any other field on the profile.
        (isAdminOrCoach() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      ) && (
        // Two accounts are protected from having their role changed. This used
        // to demand the role BE 'admin' after any write, which is
        // unsatisfiable for a protected account that is a player — so every
        // edit to it was denied, streaks and usernames included, not just
        // role changes. What it should say is that the role must not move.
        !(resource.data.get('email', '') in ['khaled05062006@gmail.com', 'fedizayen12@gmail.com']) ||
        request.resource.data.get('role', '') == resource.data.get('role', '')
      );

      // Delete: admin only
      allow delete: if isAdmin();

      // Coach-authored private notes about this player — coach/admin only,
      // not visible to or editable by the player themselves.
      match /coachNotes/{noteId} {
        allow read, write: if isAdminOrCoach();
      }

      // Per-user subcollections: gymVideos, footballVideos, progressPhotos, bodyweightLogs, etc.
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) || isAdminOrCoach();
      }
    }

    // SIGNUP / ONBOARDING ANSWERS
    // One doc per user: /signupAnswers/{userId}
    match /signupAnswers/{userId} {
      // CREATE: the signed-in user creates their own doc
      // Require userId field to match auth.uid
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid;

      // READ: owner, coach, admin
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        getUserRole(request.auth.uid) in ['admin','coach']
      );

      // UPDATE:
      // - Admin/coach can always edit
      // - Owner can edit too (remove the owner line if you want admin-only edits)
      allow update: if request.auth != null && (
        getUserRole(request.auth.uid) in ['admin','coach'] ||
        request.auth.uid == userId
      );

      // DELETE: admin only
      allow delete: if isAdmin();
    }

    // NUTRITION LOGS
    match /nutritionLogs/{logId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdminOrCoach());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // FOOTBALL MATCHES
    match /football_matches/{matchId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdminOrCoach());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // TENNIS MATCHES
    match /tennis_matches/{matchId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdminOrCoach());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // BASKETBALL / BOXING / SWIMMING (generic sport-module entries)
    match /basketball_games/{entryId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdminOrCoach());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /boxing_bouts/{entryId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdminOrCoach());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
    // An athlete's own planned sessions, per sport. Same ownership shape as
    // the match collections above: you write your own, a coach or admin may
    // read them. Distinct from `trainingSessions`, which is the coach's
    // team-wide schedule.
    // Clips an athlete submits for a coach to review. The athlete writes their
    // own; a coach or admin may list every submission and is the only one who
    // can write the feedback back onto it.
    match /player_videos/{videoId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdminOrCoach());
      allow list: if isAdminOrCoach();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isAdminOrCoach()
                    || (request.auth != null && resource.data.userId == request.auth.uid);
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /athlete_sessions/{sessionId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdminOrCoach());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /swimming_sessions/{entryId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdminOrCoach());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // SUPPORT TICKETS (problem reports + help requests, incl. streak restores)
    match /supportTickets/{ticketId} {
      // Author reads their own; admins read every ticket.
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Only admins triage (status, reply); authors may not edit after filing.
      allow update, delete: if isAdmin();

      // Threaded conversation on a ticket — the author and any admin can both
      // post, so a report can go back and forth instead of a single reply.
      match /replies/{replyId} {
        function ticket() {
          return get(/databases/$(database)/documents/supportTickets/$(ticketId)).data;
        }
        allow read: if request.auth != null &&
          (ticket().userId == request.auth.uid || isAdmin());
        allow create: if request.auth != null &&
          request.resource.data.authorId == request.auth.uid &&
          (ticket().userId == request.auth.uid || isAdmin());
        allow update, delete: if isAdmin();
      }
    }

    // PERSONAL GOALS (athlete-set targets with progress tracking)
    match /goals/{goalId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdminOrCoach());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // BODY SCANS (athlete body-composition scans + AI analysis history)
    match /bodyScans/{scanId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdminOrCoach());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // COACH-MANAGED TEAM MATCHES (read-only for everyone signed in, managed by coach/admin)
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow write: if isAdminOrCoach();
    }

    // TRAINING SESSIONS (coach-created practice sessions, with attendance)
    match /trainingSessions/{sessionId} {
      allow read: if canReadShared();
      allow create: if isAdminOrCoach() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (resource.data.ownerId == request.auth.uid);
    }

    // COACH MATCHES (schedule, lineups, tactics notes for the coach platform)
    match /coachMatches/{matchId} {
      allow read: if request.auth != null;
      allow write: if isAdminOrCoach();
    }

    // RESOURCES (drills, videos, documents, links — coach content library)
    match /resources/{resourceId} {
      allow read: if canReadShared();
      allow create: if isAdminOrCoach() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (resource.data.ownerId == request.auth.uid);

      // Timeline comments on a resource (e.g. video review)
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if request.auth != null &&
          (resource.data.createdBy == request.auth.uid || isAdminOrCoach());
      }
    }

    // PERFORMANCE REPORTS (coach-authored, player-targeted or whole-team)
    match /reports/{reportId} {
      // A report is also visible to the athlete it is about, whatever its
      // sharing settings — it is their assessment. A report addressed to the
      // whole team stays readable by the team: "whole team" is already the
      // coach's stated audience, and ownership defaults to private, which
      // would otherwise have silently stopped those reaching anyone.
      allow read: if request.auth != null && (
        canReadShared() ||
        resource.data.targetPlayerUid == request.auth.uid ||
        resource.data.targetPlayerUid == null
      );
      allow create: if isAdminOrCoach() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin()
        || (resource.data.ownerId == request.auth.uid)
        || (resource.data.createdBy == request.auth.uid);
    }

    // FRIENDSHIPS
    // One document per pair, named `uidA_uidB` with the uids sorted. The same
    // id is used for that pair's conversation, so the messaging rules below can
    // check the friendship directly instead of keeping a second copy of who is
    // allowed to talk to whom.
    match /friendships/{friendshipId} {
      function pair() { return resource.data.users; }

      // `resource` is null for a document that does not exist, and
      // dereferencing it fails the rule outright rather than returning "not
      // found" — which turned a harmless existence check into a permission
      // error. A get on a missing friendship now simply comes back empty.
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in pair());

      // Sending a request: you must be in the pair, you must be the one asking,
      // it starts pending, and the id must be the sorted pair — otherwise two
      // documents could describe the same friendship in different states.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && friendshipId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.users[0] < request.resource.data.users[1];

      // Only the person who was asked can accept, and only into 'accepted'.
      // Without the requestedBy check a sender could befriend themselves to
      // anyone simply by updating their own pending request.
      allow update: if request.auth != null
        && request.auth.uid in pair()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && resource.data.requestedBy != request.auth.uid
        && request.resource.data.users == resource.data.users
        && request.resource.data.requestedBy == resource.data.requestedBy;

      // Decline, cancel and unfriend are all the same write.
      allow delete: if request.auth != null && request.auth.uid in pair();
    }

    // MESSAGING
    function areFriends(conversationId) {
      return exists(/databases/$(database)/documents/friendships/$(conversationId))
        && get(/databases/$(database)/documents/friendships/$(conversationId)).data.status == 'accepted';
    }

    match /conversations/{conversationId} {
      // Reading an existing thread only needs membership: an accepted
      // friendship that is later removed should not lock someone out of
      // messages they have already exchanged.
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;

      // Writing needs an accepted friendship. This is where the privacy rule
      // actually lives — a contact list filtered in the client is a
      // suggestion, not a restriction.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && areFriends(conversationId);
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && areFriends(conversationId);

      match /messages/{messageId} {
        function parentPath() {
          return /databases/$(database)/documents/conversations/$(conversationId);
        }
        function isParticipant() {
          return request.auth != null
            && exists(parentPath())
            && request.auth.uid in get(parentPath()).data.participants;
        }

        // Writing requires membership of the parent conversation, which the
        // client creates and awaits before a thread's first message. That
        // closes the old hole where anyone signed in could write into any
        // conversation id whose parent document did not exist.
        allow create: if isParticipant()
          && request.resource.data.senderId == request.auth.uid
          && areFriends(conversationId);

        // Reading tolerates a missing parent, and has to: opening a brand-new
        // thread attaches the message listener before anything has been sent,
        // and Firestore does not retry a listener it has denied — the sender
        // would not even see their own first message appear. This is no longer
        // a hole, because the create rule above means a conversation with no
        // parent document can hold no messages at all: verified against the
        // live database, where no such orphaned messages exist.
        allow read: if request.auth != null
          && (!exists(parentPath()) || isParticipant());
      }
    }
  }
}
