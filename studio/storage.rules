rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Progress photos (gym body-transformation tracking)
    match /progressPhotos/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Gym workout videos for AI form review
    match /gym-videos/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Football match/training videos for AI review
    match /football-videos/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Screenshots attached to a support ticket. The author uploads under their
    // own uid; any signed-in user may read, because an admin has to open the
    // image while triaging a report they did not write.
    match /supportAttachments/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Profile pictures - viewable by any signed-in user (avatars), editable by owner only
    match /profilePictures/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Exercise demonstration GIFs — shared app content, not user data. Any
    // signed-in athlete can view them; nobody writes from the client, they are
    // seeded once by an admin script (scripts/upload-exercise-gifs.mjs).
    match /exerciseMedia/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
