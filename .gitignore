.DS_Store

# Installed dependencies, at any depth. studio/.gitignore covered its own
# /node_modules, but the root never did, so 18,802 dependency files ended up
# tracked — 98% of everything in the repo. They rebuild from the lockfiles.
node_modules/

# Raw Kaggle CSV source files — only the built data/food-db.json ships
fooddatabase/
studio/tmp-food/

# Raw datasets (391 MB of CSV and GIFs). Consumed by build scripts and
# served from Storage — never committed: GitHub rejects files over 100 MB and
# a git add -A once swept the whole folder into a commit.
datasets/
